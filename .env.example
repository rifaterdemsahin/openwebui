# .env.example - Local environment variables template
# NOTE: Real secrets are never committed to git. Load them at runtime via Azure Key Vault.
# This project currently needs NO secrets — Ollama + Open WebUI run unauthenticated on localhost.
# The block below documents the pattern for if/when a secret is ever needed.

# --- AZURE KEY VAULT CONFIGURATION (existing vault — do not create a new one) ---
AZURE_KEYVAULT_NAME="dp-kv-deliverypilot"
AZURE_TENANT_ID="your-azure-tenant-id"
AZURE_CLIENT_ID="your-service-principal-client-id"
AZURE_CLIENT_SECRET="your-service-principal-client-secret"

# --- LOCAL AI STACK (ACTUALLY USED BY THIS PROJECT) ---
OLLAMA_HOST="http://localhost:11434"
OPEN_WEBUI_PORT="8080"

# --- OPTIONAL: only if this project later adds a semantic-search index over the codebase ---
# EMBEDDING_MODEL="nomic-embed-text"
# QDRANT_HOST="http://localhost:6333"
